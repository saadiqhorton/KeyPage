PORT=9090
KEYPAGE_DATA_DIR=/app/data
KEYPAGE_WEB_DIR=/app/web
KEYPAGE_SESSION_IDLE_MINUTES=20
KEYPAGE_SESSION_ABSOLUTE_HOURS=12
KEYPAGE_CLIPBOARD_CLEAR_SECONDS=30
KEYPAGE_LOGIN_MAX_ATTEMPTS=5
KEYPAGE_LOGIN_LOCKOUT_MINUTES=5
# true behind Cloudflare Tunnel or another reverse proxy that rewrites Host
KEYPAGE_TRUST_PROXY=false
