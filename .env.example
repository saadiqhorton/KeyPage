# Keep in sync with DEFAULT_LISTEN_PORT in packages/shared/src/app.ts
PORT=9090
KEYPAGE_DATA_DIR=/app/data
KEYPAGE_WEB_DIR=/app/apps/web/dist
# Setting this pins the session idle timeout and makes the Settings UI control
# read-only. Leave it unset to manage the timeout from Settings.
# Valid range: 15–30 minutes (Settings options: 15, 20, 25, 30).
# KEYPAGE_SESSION_IDLE_MINUTES=20
KEYPAGE_SESSION_ABSOLUTE_HOURS=12
KEYPAGE_CLIPBOARD_CLEAR_SECONDS=30
KEYPAGE_LOGIN_MAX_ATTEMPTS=5
KEYPAGE_LOGIN_LOCKOUT_MINUTES=5
# HTTPS-first claim is the default. For an intentional one-time recovery claim
# over HTTP, only a direct loopback client can use this override.
KEYPAGE_REQUIRE_HTTPS_SETUP=true
KEYPAGE_ALLOW_INSECURE_LOCAL_SETUP=false
KEYPAGE_SETUP_TOKEN_TTL_MINUTES=15
# Required canonical browser origin when a reverse proxy/Tunnel is used.
# KEYPAGE_PUBLIC_ORIGIN=https://keys.example.com
# Comma-separated proxy IP/CIDR allowlist. Forwarded headers from every other
# peer are ignored. Never use a catch-all network.
# KEYPAGE_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/24
